%%{init: {'theme':'base','themeVariables':{'fontFamily':'Times New Roman','fontSize':'18px','primaryColor':'#ffffff','primaryTextColor':'#111111','primaryBorderColor':'#222222','lineColor':'#222222','background':'#ffffff'}, 'flowchart': {'curve': 'linear','nodeSpacing': 40,'rankSpacing': 45}}}%%
flowchart TD
    A[Input desc B,H,W,C] --> B[Permute to desc_map B,C,H,W]
    G[Input geo_v B,Cg,H,W] --> H[GeoProj 1x1 Conv plus BN plus GELU]

    H --> I{LocalContext enabled}
    I -->|Yes| J[GeoContextBlock stacked]
    I -->|No| K[Bypass]
    J --> L
    K --> L

    L{MultiScaleGeo enabled}
    L -->|Yes| M[DWConv over MS_K_SCALES plus softmax weights]
    L -->|No| N[Single-scale geo feature]
    M --> O[geo_feat]
    N --> O

    B --> P[Concat desc_map and geo_feat]
    O --> P

    P --> Q[ReliabilityHead]
    Q --> R[sigmoid reliability_map]
    R --> S[Apply gate_floor]

    O --> T[FiLM generator]
    T --> U[Produce scale and shift]
    S --> U
    U --> V[Build residual desc*scale plus shift]

    P --> W{ChannelGate enabled}
    W -->|Yes| X[Per-channel residual scaling]
    W -->|No| Y[Bypass]
    V --> Z[Residual update]
    X --> Z
    Y --> Z

    R --> AA{ResidualGate enabled}
    AA -->|Yes| AB[Build residual_gate]
    AA -->|No| AC[Skip residual_gate]

    P --> AD{CoupledScaleGate enabled}
    AD -->|Yes| AE[Build coupled_gate]
    AD -->|No| AF[Skip coupled_gate]

    AB --> AG[Compose final gate]
    AC --> AG
    AE --> AG
    AF --> AG

    Z --> AH[out = desc + residual_gain * gate * residual]
    AG --> AH
    AH --> AI[LayerNorm]
    AI --> AJ[Output refined_desc B,H,W,C]
    R --> AK[Output geo_reliability_map B,1,H,W]

    style Q fill:#ffe9c6,stroke:#333,stroke-width:1.2px
    style T fill:#ffe9c6,stroke:#333,stroke-width:1.2px
    style AI fill:#dceeff,stroke:#333,stroke-width:1.2px
