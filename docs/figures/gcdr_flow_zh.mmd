%%{init: {'theme':'base','themeVariables':{'fontFamily':'Times New Roman','fontSize':'18px','primaryColor':'#ffffff','primaryTextColor':'#111111','primaryBorderColor':'#222222','lineColor':'#222222','background':'#ffffff'}, 'flowchart': {'curve': 'linear','nodeSpacing': 40,'rankSpacing': 45}}}%%
flowchart TD
    A[输入描述子 desc: B,H,W,C] --> B[转置为 desc_map: B,C,H,W]
    G[输入几何 geo_v: B,Cg,H,W] --> H[GeoProj 1x1 Conv + BN + GELU]

    H --> I{LOCAL_CONTEXT_LAYERS gt 0}
    I -->|是| J[GeoContextBlock 堆叠]
    I -->|否| K[跳过]
    J --> L
    K --> L

    L{USE_MULTI_SCALE_GEO enabled}
    L -->|是| M[多尺度深度可分离卷积 + 可学习权重]
    L -->|否| N[单尺度几何特征]
    M --> O[geo_feat]
    N --> O

    B --> P[拼接: cat desc_map 与 geo_feat]
    O --> P

    P --> Q[ReliabilityHead]
    Q --> R[sigmoid 得到 reliability_map]
    R --> S[门控下限修正 gate_floor]

    O --> T[FiLM 生成 scale 与 shift]
    T --> U[scale=tanh(scale)*gate]
    S --> U
    U --> V[残差项: residual = desc*scale + shift]

    P --> W{USE_CHANNEL_GATE}
    W -->|是| X[通道门控残差缩放]
    W -->|否| Y[跳过]
    V --> Z[更新 residual]
    X --> Z
    Y --> Z

    R --> AA{USE_RESIDUAL_GATE}
    AA -->|是| AB[构建 residual_gate]
    AA -->|否| AC[无 residual_gate]

    P --> AD{USE_COUPLED_SCALE_GATE}
    AD -->|是| AE[构建 coupled_gate]
    AD -->|否| AF[无 coupled_gate]

    AB --> AG[组合最终 gate]
    AC --> AG
    AE --> AG
    AF --> AG

    Z --> AH[输出融合: out = desc + residual_gain * gate * residual]
    AG --> AH
    AH --> AI[LayerNorm]
    AI --> AJ[输出 refined_desc: B,H,W,C]
    R --> AK[输出 geo_reliability_map: B,1,H,W]

    style Q fill:#ffe9c6,stroke:#333,stroke-width:1.2px
    style T fill:#ffe9c6,stroke:#333,stroke-width:1.2px
    style AI fill:#dceeff,stroke:#333,stroke-width:1.2px
